# Application runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# faster-whisper model configuration. Docker pre-downloads this same default.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Maximum transcription requests admitted into the inference workflow.
# Requests above this limit receive HTTP 503 SERVICE_BUSY instead of waiting.
MAX_ADMITTED_INFERENCE_REQUESTS=2

# Audio uploads
MAX_UPLOAD_SIZE_BYTES=15728640
SUPPORTED_AUDIO_EXTENSIONS=webm,wav,mp3,m4a,ogg,mp4,aac,flac
# Relative paths work on local Windows/Linux development; the Docker image
# overrides this with /tmp/multilingual-speech-api.
TEMP_DIRECTORY=./.tmp/multilingual-speech-api

# Text-to-speech
TTS_DEFAULT_VOICE=en-US-AvaNeural
TTS_ALLOWED_VOICES=hi-IN-SwaraNeural,en-US-AvaNeural,mr-IN-AarohiNeural,ta-IN-PallaviNeural,te-IN-ShrutiNeural
TTS_MAX_TEXT_CHARACTERS=5000
